{
  "id": "io.gitlab.TitouanReal.Era.Eds.Devel",
  "runtime": "org.gnome.Platform",
  "runtime-version": "master",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "era",
  "finish-args": [
    "--share=ipc",
    "--device=dri",
    "--socket=wayland",
    "--system-talk-name=org.freedesktop.timedate1",
    "--talk-name=org.gnome.evolution.dataserver.Sources5",
    "--talk-name=org.gnome.evolution.dataserver.Calendar8"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "build-args": ["--share=network"],
    "env": {
      "RUST_BACKTRACE": "1",
      "RUST_LOG": "era=debug"
    }
  },
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/man",
    "/share/doc",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "grass",
      "buildsystem": "simple",
      "build-options": {
        "env": {
          "CARGO_HOME": "/run/build/grass/cargo"
        }
      },
      "build-commands": [
        "cargo build --release --locked",
        "mkdir -p /app/bin",
        "install -D ./target/release/grass /app/bin/"
      ],
      "cleanup": ["*"],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/connorskees/grass",
          "tag": "0.13.4",
          "commit": "e0bb9e2eabfc3a58e42b03089cd7b22c68d09d0b",
          "disable-submodules": true
        }
      ]
    },
    {
      "name": "meson",
      "buildsystem": "simple",
      "build-commands": ["python3 setup.py install --prefix=/app"],
      "cleanup": ["*"],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/TitouanReal/meson",
          "branch": "cargo-env"
        }
      ]
    },
    {
      "name": "libical",
      "cleanup": ["/lib/cmake"],
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DCMAKE_INSTALL_LIBDIR:PATH=/app/lib",
        "-DBUILD_SHARED_LIBS=On",
        "-DICAL_BUILD_DOCS=False",
        "-DWITH_CXX_BINDINGS=False"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/libical/libical/releases/download/v3.0.20/libical-3.0.20.tar.gz",
          "sha256": "e73de92f5a6ce84c1b00306446b290a2b08cdf0a80988eca0a2c9d5c3510b4c2"
        }
      ]
    },
    {
      "name": "evolution-data-server",
      "cleanup": ["/share/GConf"],
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DENABLE_CANBERRA=OFF",
        "-DENABLE_GOA=OFF",
        "-DENABLE_DOT_LOCKING=OFF",
        "-DENABLE_FILE_LOCKING=fcntl",
        "-DENABLE_GTK=OFF",
        "-DENABLE_GTK4=ON",
        "-DENABLE_GOOGLE=OFF",
        "-DENABLE_VALA_BINDINGS=OFF",
        "-DENABLE_WEATHER=OFF",
        "-DWITH_OPENLDAP=OFF",
        "-DWITH_LIBDB=OFF",
        "-DENABLE_INTROSPECTION=OFF",
        "-DENABLE_INSTALLED_TESTS=OFF",
        "-DENABLE_GTK_DOC=OFF",
        "-DENABLE_EXAMPLES=OFF",
        "-DENABLE_OAUTH2_WEBKITGTK4=OFF"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/GNOME/evolution-data-server.git"
        }
      ]
    },
    {
      "name": "libclepsydre",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/TitouanReal/clepsydre.git",
          "commit": "3afa6141fbb43fc49e929b51d090f76ca1d41cfb"
        }
      ],
      "config-opts": ["-Dlibclepsydre=true", "-Dintrospection=true"]
    },
    {
      "name": "libclepsydre-eds",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/TitouanReal/clepsydre.git",
          "commit": "3afa6141fbb43fc49e929b51d090f76ca1d41cfb"
        }
      ],
      "config-opts": ["-Dlibclepsydre-eds=true", "-Dintrospection=true"]
    },
    {
      "name": "era",
      "builddir": true,
      "buildsystem": "meson",
      "sources": [
        {
          "type": "dir",
          "path": "../"
        }
      ],
      "config-opts": ["-Dcalendar-backend=eds", "-Dplatform=flatpak"]
    }
  ]
}
