{
    "id": "org.gnome.gitlab.TitouanReal.Era.Eds.Devel",
    "runtime": "org.gnome.Platform",
    "runtime-version": "master",
    "sdk": "org.gnome.Sdk",
    "command": "era",
    "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
    "finish-args": [
        "--share=ipc",
        "--device=dri",
        "--socket=wayland",
        "--system-talk-name=org.freedesktop.timedate1",
        "--talk-name=org.gnome.evolution.dataserver.Sources5",
        "--talk-name=org.gnome.evolution.dataserver.Calendar8"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "build-args": ["--share=network"],
        "env": {
            "RUST_BACKTRACE": "1",
            "RUST_LOG": "era=debug"
        }
    },
    "modules": [
        {
            "name": "grass",
            "buildsystem": "simple",
            "build-options": {
                "env": {
                    "CARGO_HOME": "/run/build/grass/cargo"
                }
            },
            "build-commands": [
                "cargo build --release --locked",
                "mkdir -p /app/bin",
                "install -D ./target/release/grass /app/bin/"
            ],
            "cleanup": ["*"],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/connorskees/grass",
                    "tag": "0.13.4",
                    "commit": "e0bb9e2eabfc3a58e42b03089cd7b22c68d09d0b",
                    "disable-submodules": true
                }
            ]
        },
        {
            "name": "meson",
            "buildsystem": "simple",
            "build-commands": ["python3 setup.py install --prefix=/app"],
            "cleanup": ["*"],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/TitouanReal/meson",
                    "branch": "cargo-env"
                }
            ]
        },
        {
            "name": "libical",
            "cleanup": ["/lib/cmake"],
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_INSTALL_LIBDIR:PATH=/app/lib",
                "-DBUILD_SHARED_LIBS=On",
                "-DICAL_BUILD_DOCS=False",
                "-DLIBICAL_CXX_BINDINGS=False",
                "-DLIBICAL_JAVA_BINDINGS=False"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libical/libical/releases/download/v4.0.6/libical-4.0.6.tar.gz",
                    "sha256": "2e3729cb69c282d3bb17a8d2b198af6e4bc7502fd3621c9adf573921fe9dceb0"
                }
            ]
        },
        {
            "name": "evolution-data-server",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DENABLE_CANBERRA=OFF",
                "-DENABLE_GOA=OFF",
                "-DENABLE_DOT_LOCKING=OFF",
                "-DENABLE_FILE_LOCKING=fcntl",
                "-DENABLE_GTK=OFF",
                "-DENABLE_GTK4=ON",
                "-DENABLE_GOOGLE=OFF",
                "-DENABLE_VALA_BINDINGS=OFF",
                "-DENABLE_WEATHER=OFF",
                "-DWITH_OPENLDAP=OFF",
                "-DWITH_LIBDB=OFF",
                "-DENABLE_INTROSPECTION=OFF",
                "-DENABLE_INSTALLED_TESTS=OFF",
                "-DENABLE_GTK_DOC=OFF",
                "-DENABLE_EXAMPLES=OFF",
                "-DENABLE_OAUTH2_WEBKITGTK4=OFF"
            ],
            "cleanup": ["/share/GConf"],
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.gnome.org/GNOME/evolution-data-server.git",
                    "commit": "757672184698ec9f46cc16cf8860ec312d1e9d36"
                }
            ]
        },
        {
            "name": "libclepsydre",
            "buildsystem": "meson",
            "config-opts": ["-Dlibclepsydre=true", "-Dintrospection=true"],
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.gnome.org/TitouanReal/clepsydre.git",
                    "commit": "95a4a4ba6196c2f60293967289119f5316ba41d9"
                }
            ]
        },
        {
            "name": "libclepsydre-eds",
            "buildsystem": "meson",
            "config-opts": ["-Dlibclepsydre-eds=true", "-Dintrospection=true"],
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.gnome.org/TitouanReal/clepsydre.git",
                    "commit": "95a4a4ba6196c2f60293967289119f5316ba41d9"
                }
            ]
        },
        {
            "name": "era",
            "buildsystem": "meson",
            "builddir": true,
            "config-opts": ["-Dcalendar-backend=eds", "-Dplatform=flatpak", "-Drelease-type=devel"],
            "sources": [
                {
                    "type": "dir",
                    "path": "../"
                }
            ]
        }
    ]
}
