<?xml version="1.0" encoding="UTF-8" ?>
<app
    xmlns="https://sp1rit.arpa/pixiewood/"
    xmlns:xi="http://www.w3.org/2001/XInclude"
>
	<metainfo>
		<component
            xmlns="https://specifications.freedesktop.org/metainfo/1.0"
            type="desktop"
        >
			<id>org.gnome.gitlab.TitouanReal.Era</id>
			<name>Era</name>
			<releases>
				<release version="0.1.0">
					<description>
						<p>Initial Android release</p>
					</description>
				</release>
			</releases>
		</component>
	</metainfo>
	<style>
		<theme name="adw" />
		<icon type="generate">
			<drawable
                target="foreground"
                scale=".5"
                type="svg"
                path="src://data/icons/org.gnome.gitlab.TitouanReal.Era.Devel.svg"
            />
			<color target="background">#FFFFFF</color>
			<drawable
                target="monochrome"
                scale=".5"
                type="svg"
                path="src://data/icons/org.gnome.gitlab.TitouanReal.Era-symbolic.svg"
            />
		</icon>
	</style>
	<dependencies>
		<glib>
			<patch>hack</patch>
		</glib>
	</dependencies>
	<build target="era">
		<architectures>
			<arch>aarch64</arch>
			<arch>x86_64</arch>
		</architectures>
		<configure-options>
			<option>--cross=build-aux/android/rust.cross</option>
			<option>--native=build-aux/android/rust.native</option>
			<option>-Dcalendar-backend=android</option>
			<option>-Dplatform=android</option>
		</configure-options>
	</build>
</app>
