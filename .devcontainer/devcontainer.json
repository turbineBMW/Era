{
  "name": "Kalendasom Dev",
  "build": {
    "dockerfile": "Dockerfile",
  },
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/root/.ssh,type=bind,consistency=cached",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.config/fish,target=/root/.config/fish,type=bind,consistency=cached",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.config/git/config,target=/root/.config/git/config,type=bind,consistency=cached",
    "source=/etc/localtime,target=/etc/localtime,type=bind,readonly",
  ],
}
