#. TRANSLATORS: date of a single all-day event, of the current year.
#. {month} is the month name (e.g. "June"), {day} is the day number (e.g.
#. "12").
#: src/utils/timeframe_label.rs:91
#, rust-format
msgid "{month} {day}"
msgstr "{month} {day}"

#. TRANSLATORS: date of a single all-day event.
#. {month} is the month name (e.g. "June"), {day} is the day number (e.g.
#. "12"),
#. {year} is the year (e.g. "2025").
#: src/utils/timeframe_label.rs:99
#, rust-format
msgid "{month} {day}, {year}"
msgstr "{month} {day}, {year}"

#. e.g. "June 12 – 15"
#. TRANSLATORS: all-day event range within the same month of the current year.
#. {month} month name, {day_start} and {day_end} day numbers.
#: src/utils/timeframe_label.rs:112
#, rust-format
msgid "{month} {day_start} – {day_end}"
msgstr "{month} {day_start} – {day_end}"

#. e.g. "June 12 – 15, 2025"
#. TRANSLATORS: all-day event range within the same month of a past or future
#. year.
#. {month} month name, {day_start} and {day_end} day numbers, {year} year.
#: src/utils/timeframe_label.rs:121
#, rust-format
msgid "{month} {day_start} – {day_end}, {year}"
msgstr "{month} {day_start} – {day_end}, {year}"

#. e.g. "June 12 – July 3"
#. TRANSLATORS: all-day event range spanning different months in the current
#. year.
#. {month_start} and {month_end} month names, {day_start} and {day_end} day
#. numbers.
#: src/utils/timeframe_label.rs:135
#, rust-format
msgid "{month_start} {day_start} – {month_end} {day_end}"
msgstr "{month_start} {day_start} – {month_end} {day_end}"

#. e.g. "June 12 – July 3, 2025"
#. TRANSLATORS: all-day event range spanning different months in a past or
#. future year.
#. {month_start} and {month_end} month names, {day_start} and {day_end} day
#. numbers,
#. {year} the shared year.
#: src/utils/timeframe_label.rs:150
#, rust-format
msgid "{month_start} {day_start} – {month_end} {day_end}, {year}"
msgstr "{month_start} {day_start} – {month_end} {day_end}, {year}"

#. e.g. "June 12, 2024 – January 3, 2025"
#. TRANSLATORS: all-day event range spanning different years.
#. {month_start} and {month_end} month names, {day_start} and {day_end} day
#. numbers,
#. {year_start} and {year_end} years.
#: src/utils/timeframe_label.rs:162
#, rust-format
msgid ""
"{month_start} {day_start}, {year_start} – {month_end} {day_end}, {year_end}"
msgstr ""
"{month_start} {day_start}, {year_start} – {month_end} {day_end}, {year_end}"

#. e.g. "June 12, 14:00 – 15:30"
#. TRANSLATORS: timed event on a single day, system timezone (not shown).
#. {month} month name, {day} day number, {time_start} and {time_end} clock
#. times.
#: src/utils/timeframe_label.rs:233
#, rust-format
msgid "{month} {day}, {time_start} – {time_end}"
msgstr "{month} {day}, {time_start} – {time_end}"

#. e.g. "June 12, 14:00 (America/New_York) – 15:30 (Europe/Paris)"
#. TRANSLATORS: timed event on a single day, each time in a different non-
#. system
#. timezone. {month}, {day}, {time_start}, {time_end} as above;
#. {tz_start} and {tz_end} the respective IANA timezones.
#: src/utils/timeframe_label.rs:244
#, rust-format
msgid "{month} {day}, {time_start} ({tz_start}) – {time_end} ({tz_end})"
msgstr "{month} {day}, {time_start} ({tz_start}) – {time_end} ({tz_end})"

#. e.g. "June 12, 14:00 – July 3, 15:30"
#. TRANSLATORS: timed event spanning months within the current year, system
#. timezone.
#. {month_start}, {day_start}, {time_start} start date/time;
#. {month_end}, {day_end}, {time_end} end date/time.
#: src/utils/timeframe_label.rs:262
#, rust-format
msgid ""
"{month_start} {day_start}, {time_start} – {month_end} {day_end}, {time_end}"
msgstr ""
"{month_start} {day_start}, {time_start} – {month_end} {day_end}, {time_end}"

#. e.g. "June 12, 14:00 (America/New_York) – July 3, 15:30 (Europe/Paris)"
#. TRANSLATORS: cross-month current-year range; each time in a different non-
#. system
#. timezone. {month_start}, {day_start}, {time_start}, {month_end}, {day_end},
#. {time_end} as above; {tz_start} and {tz_end} respective IANA timezones.
#: src/utils/timeframe_label.rs:280
#, rust-format
msgid ""
"{month_start} {day_start}, {time_start} ({tz_start}) – {month_end} {day_end}, "
"{time_end} ({tz_end})"
msgstr ""
"{month_start} {day_start}, {time_start} ({tz_start}) – {month_end} {day_end}, "
"{time_end} ({tz_end})"

#. e.g. "June 12, 14:00 – July 3, 15:30, 2025"
#. TRANSLATORS: timed event spanning months within a past or future year,
#. system
#. timezone. {month_start}, {day_start}, {time_start}, {month_end}, {day_end},
#. {time_end} as above; {year} the shared year.
#: src/utils/timeframe_label.rs:300
#, rust-format
msgid ""
"{month_start} {day_start}, {time_start} – {month_end} {day_end}, {time_end}, "
"{year}"
msgstr ""
"{month_start} {day_start}, {time_start} – {month_end} {day_end}, {time_end}, "
"{year}"

#. e.g. "June 12, 14:00 (America/New_York) – July 3, 15:30 (Europe/Paris),
#. 2025"
#. TRANSLATORS: cross-month past/future-year range; each time in a different
#. non-system
#. timezone. {month_start}, {day_start}, {time_start}, {month_end}, {day_end},
#. {time_end}, {year} as above; {tz_start} and {tz_end} respective IANA
#. timezones.
#: src/utils/timeframe_label.rs:319
#, rust-format
msgid ""
"{month_start} {day_start}, {time_start} ({tz_start}) – {month_end} {day_end}, "
"{time_end} ({tz_end}), {year}"
msgstr ""
"{month_start} {day_start}, {time_start} ({tz_start}) – {month_end} {day_end}, "
"{time_end} ({tz_end}), {year}"

#. e.g. "June 12, 2024, 14:00 – January 3, 2025, 15:30"
#. TRANSLATORS: timed event spanning different years, system timezone.
#. {month_start}, {day_start}, {year_start}, {time_start} start date/time;
#. {month_end}, {day_end}, {year_end}, {time_end} end date/time.
#: src/utils/timeframe_label.rs:335
#, rust-format
msgid ""
"{month_start} {day_start}, {year_start}, {time_start} – {month_end} {day_end}, "
"{year_end}, {time_end}"
msgstr ""
"{month_start} {day_start}, {year_start}, {time_start} – {month_end} {day_end}, "
"{year_end}, {time_end}"

#. e.g. "June 12, 2024, 14:00 (America/New_York) – January 3, 2025, 15:30
#. (Europe/Paris)" TRANSLATORS: different-year range; each time in a
#. different non-system timezone. {month_start}, {day_start}, {year_start},
#. {time_start}, {month_end}, {day_end}, {year_end}, {time_end} as above;
#. {tz_start} and {tz_end} respective IANA timezones.
#: src/utils/timeframe_label.rs:351
#, rust-format
msgid ""
"{month_start} {day_start}, {year_start}, {time_start} ({tz_start}) – "
"{month_end} {day_end}, {year_end}, {time_end} ({tz_end})"
msgstr ""
"{month_start} {day_start}, {year_start}, {time_start} ({tz_start}) – "
"{month_end} {day_end}, {year_end}, {time_end} ({tz_end})"

#: src/widgets/window.rs:496
msgid "%Y"
msgstr "%Y"

#: src/widgets/window.rs:505 src/widgets/window.rs:514
msgid "%0B %Y"
msgstr "%0B %Y"

