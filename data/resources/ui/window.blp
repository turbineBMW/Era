using Gtk 4.0;
using Adw 1;

template $EraWindow: Adw.ApplicationWindow {
  default-width: 800;
  default-height: 600;
  width-request: 360;
  height-request: 294;

  content: Stack stack {
    StackPage {
      name: "backend-unavailable";

      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          [end]
          Button {
            icon-name: "info-outline-symbolic";
            tooltip-text: _("About Era");
            action-name: "app.about";
          }
        }

        content: Adw.StatusPage {
          title: _("No Backend");
          description: _("The calendaring backend seems to not be available.");
        };
      };
    }

    StackPage {
      name: "backend-available";

      child: Adw.MultiLayoutView main_view {
        Adw.Layout {
          name: "narrow";

          content: Stack narrow_stack {
            StackPage {
              name: "year";
              title: _("Year");

              child: Adw.ToolbarView {
                [top]
                Adw.HeaderBar {
                  title-widget: Adw.WindowTitle {
                    title: bind $get_year_label(year_view.year) as <string>;
                  };

                  [end]
                  MenuButton {
                    primary: true;
                    icon-name: "open-menu-symbolic";
                    tooltip-text: _("Main Menu");
                    menu-model: primary_menu;
                  }

                  [end]
                  Button {
                    icon-name: "system-search-symbolic";
                    tooltip-text: _("Search");
                    action-name: "win.search-events";

                    styles [
                      "flat",
                    ]
                  }
                }

                content: Adw.LayoutSlot {
                  id: "year_view";
                };

                [bottom]
                ActionBar {
                  [start]
                  Button {
                    action-name: "win.today";

                    child: Adw.ButtonContent {
                      label: _("_Today");
                      use-underline: true;
                      icon-name: "today-symbolic";
                      can-shrink: true;
                      tooltip-text: _("Go to Today");
                    };
                  }

                  [end]
                  Button {
                    icon-name: "list-add-symbolic";
                    tooltip-text: _("Create Event");
                    clicked => $create_event(template);
                  }

                  [end]
                  Button {
                    icon-name: "x-office-calendar-symbolic";
                    tooltip-text: _("Manage Calendars");
                    action-name: "win.manage-calendars";
                  }
                }
              };
            }

            StackPage {
              name: "month";
              title: _("Month");

              child: Adw.ToolbarView {
                [top]
                Adw.HeaderBar {
                  [start]
                  Button {
                    icon-name: "go-previous-symbolic";
                    tooltip-text: _("Year View");
                    clicked => $go_back_to_year_view(template);
                  }

                  title-widget: Adw.WindowTitle {
                    title: bind $get_year_month_label(month_view.year, month_view.month) as <string>;
                  };

                  [end]
                  MenuButton {
                    primary: true;
                    icon-name: "open-menu-symbolic";
                    tooltip-text: _("Main Menu");
                    menu-model: primary_menu;
                  }

                  [end]
                  Button {
                    icon-name: "system-search-symbolic";
                    tooltip-text: _("Search");
                    action-name: "win.search-events";

                    styles [
                      "flat",
                    ]
                  }
                }

                content: Adw.LayoutSlot {
                  id: "month_view";
                };

                [bottom]
                ActionBar {
                  [start]
                  Button {
                    action-name: "win.today";

                    child: Adw.ButtonContent {
                      label: _("_Today");
                      use-underline: true;
                      icon-name: "today-symbolic";
                      can-shrink: true;
                      tooltip-text: _("Go to Today");
                    };
                  }

                  [end]
                  Button {
                    icon-name: "list-add-symbolic";
                    tooltip-text: _("Create Event");
                    clicked => $create_event(template);
                  }

                  [end]
                  Button {
                    icon-name: "x-office-calendar-symbolic";
                    tooltip-text: _("Manage Calendars");
                    action-name: "win.manage-calendars";
                  }
                }
              };
            }

            StackPage {
              name: "agenda";
              title: _("Agenda");

              child: Adw.ToolbarView {
                [top]
                Adw.HeaderBar {
                  title-widget: Adw.WindowTitle {
                    title: "WIP";
                  };

                  [end]
                  MenuButton {
                    primary: true;
                    icon-name: "open-menu-symbolic";
                    tooltip-text: _("Main Menu");
                    menu-model: primary_menu;
                  }

                  [end]
                  Button {
                    icon-name: "system-search-symbolic";
                    tooltip-text: _("Search");
                    action-name: "win.search-events";

                    styles [
                      "flat",
                    ]
                  }
                }

                content: Adw.LayoutSlot {
                  id: "agenda_view";
                };

                [bottom]
                ActionBar {
                  [start]
                  Button {
                    action-name: "win.today";

                    child: Adw.ButtonContent {
                      label: _("_Today");
                      use-underline: true;
                      icon-name: "today-symbolic";
                      can-shrink: true;
                      tooltip-text: _("Go to Today");
                    };
                  }

                  [end]
                  Button {
                    icon-name: "list-add-symbolic";
                    tooltip-text: _("Create Event");
                    clicked => $create_event(template);
                  }

                  [end]
                  Button {
                    icon-name: "x-office-calendar-symbolic";
                    tooltip-text: _("Manage Calendars");
                    action-name: "win.manage-calendars";
                  }
                }
              };
            }
          };
        }

        Adw.Layout {
          name: "medium";

          content: Adw.OverlaySplitView overlay_split_view {
            show-sidebar: bind sidebar_toggle.active bidirectional;
            collapsed: true;

            sidebar: $Sidebar {};

            content: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                [start]
                ToggleButton sidebar_toggle {
                  icon-name: "sidebar-show-symbolic";
                  tooltip-text: _("Toggle Sidebar");
                }

                [end]
                MenuButton {
                  primary: true;
                  icon-name: "open-menu-symbolic";
                  tooltip-text: _("Main Menu");
                  menu-model: primary_menu;
                }

                [end]
                Button {
                  icon-name: "system-search-symbolic";
                  tooltip-text: _("Search");
                  action-name: "win.search-events";

                  styles [
                    "flat",
                  ]
                }
              }

              content: Adw.ViewStack wide_view_stack {
                Adw.ViewStackPage {
                  name: "year";
                  title: _("_Year");
                  use-underline: true;
                  icon-name: "year-symbolic";

                  child: Adw.LayoutSlot {
                    id: "year_view";
                  };
                }

                Adw.ViewStackPage {
                  name: "month";
                  title: _("_Month");
                  use-underline: true;
                  icon-name: "month-symbolic";

                  child: Adw.LayoutSlot {
                    id: "month_view";
                  };
                }

                Adw.ViewStackPage {
                  name: "agenda";
                  title: _("_Agenda");
                  use-underline: true;
                  icon-name: "month-symbolic";

                  child: Adw.LayoutSlot {
                    id: "agenda_view";
                  };
                }
              };

              [bottom]
              ActionBar {
                [start]
                Button {
                  action-name: "win.today";

                  child: Adw.ButtonContent {
                    label: _("_Today");
                    use-underline: true;
                    icon-name: "today-symbolic";
                    can-shrink: true;
                    tooltip-text: _("Go to Today");
                  };
                }

                [center]
                Adw.InlineViewSwitcher wide_view_switcher {
                  stack: wide_view_stack;
                  display-mode: both;
                }

                [end]
                Button {
                  icon-name: "list-add-symbolic";
                  tooltip-text: _("Create Event");
                  clicked => $create_event(template);
                }

                [end]
                Button {
                  icon-name: "x-office-calendar-symbolic";
                  tooltip-text: _("Manage Calendars");
                  action-name: "win.manage-calendars";
                }
              }
            };
          };
        }

        [year_view]
        Adw.BreakpointBin {
          width-request: 100;
          height-request: 100;

          $YearView year_view {
            month_clicked => $open_month_view(template);
          }

          Adw.Breakpoint {
            condition ("max-width: 720sp")

            setters {
              year_view.styling: narrow;
            }
          }

          Adw.Breakpoint {
            condition ("min-width: 1100sp")

            setters {
              year_view.styling: wide;
            }
          }
        }

        [month_view]
        Adw.BreakpointBin {
          width-request: 100;
          height-request: 100;

          $MonthView month_view {}

          Adw.Breakpoint {
            condition ("max-width: 720sp")

            setters {
              month_view.styling: narrow;
            }
          }
        }

        [agenda_view]
        $AgendaView agenda_view {}
      };
    }
  };

  Adw.Breakpoint {
    condition ("max-width: 720sp")

    setters {
      template.styling: narrow;
    }
  }

  Adw.Breakpoint {
    condition ("min-width: 1000sp")

    setters {
      overlay_split_view.collapsed: false;
    }
  }
}

menu primary_menu {
  section {
    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_About Era");
      action: "app.about";
    }
  }
}

$EventCreationDialog event_creation_dialog {}

$CalendarManagementDialog calendar_management_dialog {}

$SearchDialog search_dialog {}
