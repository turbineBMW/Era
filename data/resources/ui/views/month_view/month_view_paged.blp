using Gtk 4.0;

template $MonthViewPaged: Widget {
  overflow: hidden;
  accessible-role: grid;
  hexpand: true;
  vexpand: true;

  styles [
    "paged",
  ]

  accessibility {
    label: _("Month view");
  }

  // Mouse wheel and touchpad turn the page
  EventControllerScroll {
    flags: vertical;
    scroll-begin => $scroll_begin(template);
    scroll => $scroll(template);
    scroll-end => $scroll_end(template);
  }

  // Swipe on touchscreen turns the page
  GestureSwipe {
    touch-only: true;
    swipe => $swipe(template);
  }

  // Mouse/touchpad click-drag to create a single or multi day event.
  // Touch presses are denied immediately in the handler.
  GestureDrag {
    drag-begin => $create_drag_begin(template);
    drag-update => $create_drag_update(template);
    drag-end => $create_drag_end(template);
  }
}
