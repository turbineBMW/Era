using Gtk 4.0;
using Clepsydre 0;

template $AgendaViewRow: Box {
  spacing: 6;

  $ColorStripe {
    color: bind template.event as <Clepsydre.Event>.calendar.color;
    width-request: 6;
  }

  Box {
    spacing: 12;

    Box {
      orientation: vertical;
      hexpand: true;

      Label {
        label: bind template.event as <Clepsydre.Event>.name;
        ellipsize: end;
        xalign: 0.0;
        use-markup: false;
      }

      Label {
        label: bind template.event as <Clepsydre.Event>.location;
        ellipsize: end;
        xalign: 0.0;
        use-markup: false;

        styles [
          "dim-label",
        ]
      }
    }

    Box {
      orientation: vertical;

      Label top_label {
        label: bind $top_label(
          template.event as <Clepsydre.Event>.timeframe,
          template.date,
          template.root as <Window>.application as <$EraApplication>.system as <$EraSystem>.datetime,
          template
            .root as <Window>
            .application as <$EraApplication>
            .system as <$EraSystem>
            .clock-format as <$ClockFormat>
          );
        xalign: 1.0;
        use-markup: false;
      }

      Label bottom_label {
        label: bind $bottom_label(
          template.event as <Clepsydre.Event>.timeframe,
          template.date,
          template.root as <Window>.application as <$EraApplication>.system as <$EraSystem>.datetime,
          template
            .root as <Window>
            .application as <$EraApplication>
            .system as <$EraSystem>
            .clock-format as <$ClockFormat>
          );
        xalign: 1.0;
        use-markup: false;

        styles [
          "dim-label",
        ]
      }
    }
  }
}
