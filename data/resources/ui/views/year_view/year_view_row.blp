using Gtk 4.0;

template $YearViewRow: Widget {
  styles [
    "year-view-row",
  ]

  Label year_label {
    label: bind $get_year_label_narrow(template.year) as <string>;
    xalign: 0.0;
    hexpand: true;
  }

  Separator separator {
    orientation: horizontal;
  }

  FlowBox month_flow_box {
    homogeneous: true;
    selection-mode: none;
    max-children-per-line: 3;
    child-activated => $month_cell_clicked(template);
  }
}
