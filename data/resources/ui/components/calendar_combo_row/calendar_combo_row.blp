using Gtk 4.0;
using Adw 1;
using Clepsydre 0;

template $CalendarComboRow: Adw.ComboRow {
  title: _("Calendar");

  styles [
    "calendar-combo-row",
  ]

  model: FilterListModel model {
    filter: bind template.filter;

    model: FlattenListModel {
      model: MapListModel map {
        model: SortListModel {
          sorter: StringSorter {
            expression: expr item as <Clepsydre.Collection>.name;
          };

          model: bind template
            .root as <Window>
            .application as <$EraApplication>
            .manager as <Clepsydre.Manager>
            .collections-model;
        };
      };
    };
  };

  factory: BuilderListItemFactory {
    template ListItem {
      child: $CalendarComboRowSelectedItem {
        calendar: bind template.item as <Clepsydre.Calendar>;
      };
    }
  };

  header-factory: BuilderListItemFactory {
    template ListHeader {
      child: Label {
        label: bind template.item as <Clepsydre.Calendar>.collection.name;
        ellipsize: end;
        xalign: 0.0;
        margin-start: 12;
        margin-end: 12;
      };
    }
  };

  list-factory: SignalListItemFactory {
    bind => $calendar_list_item_bind(template);
  };
}
