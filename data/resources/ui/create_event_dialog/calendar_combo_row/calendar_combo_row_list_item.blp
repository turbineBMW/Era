using Gtk 4.0;
using Gdk 4.0;

template $CalendarComboRowListItem: Box {
  spacing: 6;

  Image {
    pixel-size: 16;
    paintable: bind $get_circle_paintable(template.calendar as <$ClepsydreCalendar>.color as <Gdk.RGBA>) as <Gdk.Paintable>;
  }

  Label {
    ellipsize: end;
    xalign: 0.0;
    label: bind template.calendar as <$ClepsydreCalendar>.name;
  }

  Image {
    icon-name: "object-select-symbolic";
    visible: bind template.selected;
  }
}
