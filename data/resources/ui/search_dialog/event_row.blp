using Gtk 4.0;
using Gdk 4.0;
using Clepsydre 0;
using GLib 2.0;

template $EventRow: Box {
  margin-top: 6;
  margin-bottom: 6;

  Image {
    pixel-size: 24;
    paintable: bind $get_color_image(
      template.event as <Clepsydre.Event>.calendar as <Clepsydre.Calendar>.color as <Gdk.RGBA>
      ) as <Gdk.Paintable>;
  }

  Box {
    spacing: 12;

    Box {
      orientation: vertical;

      Label {
        label: bind template.event as <Clepsydre.Event>.name;
        ellipsize: end;
        xalign: 0.0;
        use-markup: false;
      }

      Label {
        label: bind template.event as <Clepsydre.Event>.location as <string>;
        ellipsize: end;
        xalign: 0.0;
        use-markup: false;

        styles [
          "dim-label",
        ]
      }
    }

    Box {
      orientation: vertical;
      hexpand: true;
      halign: end;

      Label {
        // TODO: Is it datetime here?
        label: bind $get_start_time(
          template.event as <Clepsydre.Event>.timeframe as <Clepsydre.Timeframe>.start as <GLib.DateTime>,
          template.event as <Clepsydre.Event>.timeframe as <Clepsydre.Timeframe>.all-day as <bool>
          ) as <string>;
        xalign: 1.0;
        use-markup: false;
      }

      Label {
        // TODO: Is it datetime here?
        label: bind $get_end_time(
          template.event as <Clepsydre.Event>.timeframe as <Clepsydre.Timeframe>.end as <GLib.DateTime>,
          template.event as <Clepsydre.Event>.timeframe as <Clepsydre.Timeframe>.all-day as <bool>
          ) as <string>;
        xalign: 1.0;
        use-markup: false;

        styles [
          "dim-label",
        ]
      }
    }
  }

  styles [
    "event-row",
  ]
}
