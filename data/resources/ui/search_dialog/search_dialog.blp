using Gtk 4.0;
using Adw 1;
using Clepsydre 0;

template $SearchDialog: Adw.Dialog {
  title: _("Search Events");
  content-height: 1000;
  content-width: 600;

  Adw.ToastOverlay toast_overlay {
    Adw.ToolbarView {
      [top]
      Adw.HeaderBar {}

      [top]
      Adw.Clamp {
        maximum-size: 400;

        Entry search_entry {
          placeholder-text: _("Search");
          notify::text => $search_events(template);
        }

        styles [
          "toolbar",
        ]
      }

      content: Stack stack {
        StackPage {
          name: "results";

          child: ScrolledWindow {
            Adw.ClampScrollable {
              ListView results_view {
                single-click-activate: true;

                factory: BuilderListItemFactory {
                  template ListItem {
                    child: $SearchResultRow {
                      event: bind template.item as <Clepsydre.Event>;
                    };
                  }
                };

                activate => $open_event_details(template);
              }
            }
          };
        }

        StackPage {
          name: "loading";

          child: Adw.Spinner {};
        }

        StackPage {
          name: "no-results";

          child: Adw.StatusPage {
            icon-name: "loupe-symbolic";
            title: _("No Results Found");
            description: _("Try a different search term");
          };
        }

        StackPage {
          name: "error";

          child: Adw.StatusPage {
            icon-name: "dialog-error-symbolic";
            title: _("Unable to Search Events");
            description: _("An error occurred in the backend. Try searching again");
          };
        }
      };
    }
  }
}
