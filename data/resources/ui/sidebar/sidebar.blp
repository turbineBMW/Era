using Gtk 4.0;
using Adw 1;
using Clepsydre 0;

template $Sidebar: Adw.Bin {
  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: ScrolledWindow {
      ListView {
        single-click-activate: true;

        styles [
          "navigation-sidebar",
        ]

        model: NoSelection {
          model: FlattenListModel {
            model: SortListModel {
              sorter: StringSorter {
                expression: expr item as <Clepsydre.Collection>.name;
              };

              model: bind template
                .root as <Window>
                .application as <$EraApplication>
                .manager as <Clepsydre.Manager>
                .collections-model;
            };
          };
        };

        activate => $toggle_calendar_visibility();

        header-factory: BuilderListItemFactory {
          template ListHeader {
            child: Label {
              label: bind template.item as <Clepsydre.Calendar>.collection as <Clepsydre.Collection>.name;
              xalign: 0;
              wrap: true;
              wrap-mode: word_char;

              styles [
                "heading",
              ]
            };
          }
        };

        factory: BuilderListItemFactory {
          template ListItem {
            child: $SidebarCalendarRow {
              calendar: bind template.item as <Clepsydre.Calendar>;
            };
          }
        };
      }
    };
  }
}
