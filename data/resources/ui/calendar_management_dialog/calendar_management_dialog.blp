using Gtk 4.0;
using Adw 1;
using Clepsydre 0;

template $CalendarManagementDialog: Adw.Dialog {
  title: _("Calendars");
  content-height: 500;
  content-width: 500;

  styles [
    "calendar-management-dialog",
  ]

  Stack stack {
    visible-child-name: bind $ternary(
      $is_zero(
        template.root as <Window>.application as <$EraApplication>.manager as <Clepsydre.Manager>.collections-model.n-items,
      ) as <bool>,
      "empty",
      "collections"
    );

    StackPage {
      name: "empty";

      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {}

        content: Adw.StatusPage {
          title: _("No collection");
          description: _("Create a collection first.");
        };
      };
    }

    StackPage {
      name: "collections";

      child: Adw.NavigationView navigation_view {
        $CollectionsListPage collections_list_page {}
      };
    }
  }
}
