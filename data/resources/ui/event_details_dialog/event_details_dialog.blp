using Gtk 4.0;
using Gdk 4.0;
using Adw 1;
using Clepsydre 0;

template $EventDetailsDialog: Adw.Dialog {
  content-height: 1000;
  content-width: 700;

  Adw.NavigationView navigation_view {
    Adw.NavigationPage {
      tag: "details";
      title: _("Event");

      Adw.ToastOverlay details_toast_overlay {
        Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            [start]
            Button {
              icon-name: "share-symbolic";
              clicked => $share(template);

              accessibility {
                label: _("Export to file");
              }
            }

            [start]
            Button {
              icon-name: "qr-code-symbolic";
              clicked => $show_qr_code(template);

              accessibility {
                label: _("Share as QR code");
              }
            }
          }

          content: Adw.PreferencesPage {
            Adw.PreferencesGroup {
              Label name_label {
                label: bind template.event as <Clepsydre.Event>.name;
                xalign: 0;
                wrap: true;
                use-markup: false;

                styles [
                  "title-4",
                ]
              }

              Label timeframe_label {
                label: bind $timeframe_label(template.event as <Clepsydre.Event>) as <string>;
                xalign: 0;
                wrap: true;
                use-markup: false;
              }
            }

            Adw.PreferencesGroup {
              visible: bind $location_or_video_conference(template.event as <Clepsydre.Event>) as <bool>;

              Adw.ActionRow {
                title: _("Location");
                subtitle: bind template.event as <Clepsydre.Event>.location as <string>;
                visible: bind $not($string_empty(template.event as <Clepsydre.Event>.location) as <bool>) as <bool>;
                use-markup: false;

                styles [
                  "property",
                ]

                [suffix]
                Button {
                  icon-name: "map-symbolic";
                  valign: center;
                  tooltip-text: _("Open Map");
                  clicked => $open_map(template);

                  accessibility {
                    label: _("Open map");
                  }

                  styles [
                    "flat",
                  ]
                }
              }

              Adw.ActionRow {
                title: _("Video Conference");
                subtitle: bind template.event as <Clepsydre.Event>.video-conference as <string>;
                visible: bind $not(
                  $string_empty(template.event as <Clepsydre.Event>.video-conference) as <bool>
                ) as <bool>;
                use-markup: false;

                styles [
                  "property",
                ]

                [suffix]
                Button {
                  label: _("Join");
                  valign: center;
                  sensitive: bind $video_conference_is_a_uri(
                    template.event as <Clepsydre.Event>.video-conference
                    ) as <bool>;
                  clicked => $join(template);
                }
              }
            }

            Adw.PreferencesGroup {
              Adw.ActionRow {
                title: _("Calendar");

                [suffix]
                Box {
                  spacing: 6;

                  Image {
                    pixel-size: 16;
                    paintable: bind $get_circle_paintable(
                      template.event as <Clepsydre.Event>.calendar as <Clepsydre.Calendar>.color as <Gdk.RGBA>
                      ) as <Gdk.Paintable>;
                  }

                  Label {
                    ellipsize: end;
                    xalign: 0.0;
                    label: bind template.event as <Clepsydre.Event>.calendar as <Clepsydre.Calendar>.name;
                  }
                }
              }
            }

            Adw.PreferencesGroup {
              visible: bind $is_some(template.event as <Clepsydre.Event>.organizer as <Clepsydre.Organizer>) as <bool>;

              Adw.ActionRow {
                title: _("Organizer");
                subtitle: bind template.event as <Clepsydre.Event>.organizer as <Clepsydre.Organizer>.name as <string>;

                styles [
                  "property",
                ]
              }

              $ParticipantsRow {
                title: _("Participants");
                attendees: participants;
                action-name: "navigation.push";
                action-target: "'participants-details'";
              }

              $ResourcesRow {
                title: _("Resources");
                attendees: resources;
                action-name: "navigation.push";
                action-target: "'resources-details'";
              }
            }

            Adw.PreferencesGroup {
              visible: bind $not($string_empty(template.event as <Clepsydre.Event>.description) as <bool>) as <bool>;

              Adw.ActionRow {
                title: _("Description");
                subtitle: bind template.event as <Clepsydre.Event>.description;
                use-markup: false;

                styles [
                  "property",
                ]
              }
            }

            Adw.PreferencesGroup {
              visible: bind $both(
                template.event as <Clepsydre.Event>.editable,
                template.event as <Clepsydre.Event>.has-recurrence,
              ) as <bool>;

              Label {
                label: _("This event has recurrence properties. Such events are currently not editable in this app.");

                styles [
                  "error",
                ]
              }
            }
          };

          [bottom]
          ActionBar {
            visible: bind $both(
              template.event as <Clepsydre.Event>.editable,
              $not(template.event as <Clepsydre.Event>.has-recurrence) as <bool>,
            ) as <bool>;

            [center]
            Box {
              homogeneous: true;
              spacing: 12;

              Button edit {
                label: _("_Edit");
                use-underline: true;
                clicked => $edit(template);

                styles [
                  "pill",
                  "suggested-action",
                ]
              }

              $LoadingButton remove {
                content-label: _("_Remove");
                use-underline: true;
                clicked => $remove(template);

                styles [
                  "pill",
                  "destructive-action",
                ]
              }
            }
          }
        }
      }
    }

    Adw.NavigationPage {
      tag: "participants-details";
      title: _("participants");

      Adw.ToastOverlay participants_details_toast_overlay {
        Adw.ToolbarView {
          [top]
          Adw.HeaderBar {}

          [top]
          Adw.Clamp {
            Entry participant_search {
              placeholder-text: _("Search Participants");
            }

            styles [
              "toolbar",
            ]
          }

          content: Adw.Clamp {
            Stack {
              visible-child-name: bind $ternary(
                $is_zero(participant_search_results.n-items) as <bool>,
                "empty",
                "participants"
              );

              StackPage {
                name: "empty";

                child: Adw.StatusPage {
                  icon-name: "loupe-symbolic";
                  title: _("No Result");
                };
              }

              StackPage {
                name: "participants";

                child: ScrolledWindow {
                  ListView {
                    show-separators: true;

                    model: NoSelection {
                      model: participant_search_results;
                    };

                    factory: BuilderListItemFactory {
                      template ListItem {
                        child: Box {
                          orientation: vertical;
                          margin-top: 12;
                          margin-bottom: 12;

                          Label {
                            label: bind template.item as <Clepsydre.Attendee>.name;
                            xalign: 0;
                            wrap: true;
                          }

                          Label {
                            label: bind template.item as <Clepsydre.Attendee>.uri;
                            xalign: 0;
                            wrap: true;
                          }
                        };
                      }
                    };

                    styles [
                      "attendees-list",
                    ]
                  }
                };
              }
            }
          };
        }
      }
    }

    Adw.NavigationPage {
      tag: "resources-details";
      title: _("Resources");

      Adw.ToastOverlay resources_details_toast_overlay {
        Adw.ToolbarView {
          [top]
          Adw.HeaderBar {}

          [top]
          Adw.Clamp {
            Entry resource_search {
              placeholder-text: _("Search Resources");
            }

            styles [
              "toolbar",
            ]
          }

          content: Adw.Clamp {
            Stack {
              visible-child-name: bind $ternary(
                $is_zero(resource_search_results.n-items) as <bool>,
                "empty",
                "resources"
              );

              StackPage {
                name: "empty";

                child: Adw.StatusPage {
                  icon-name: "loupe-symbolic";
                  title: _("No Result");
                };
              }

              StackPage {
                name: "resources";

                child: ScrolledWindow {
                  ListView {
                    show-separators: true;

                    model: NoSelection {
                      model: resource_search_results;
                    };

                    factory: BuilderListItemFactory {
                      template ListItem {
                        child: Box {
                          orientation: vertical;
                          margin-top: 12;
                          margin-bottom: 12;

                          Label {
                            label: bind template.item as <Clepsydre.Attendee>.name;
                            xalign: 0;
                            wrap: true;
                          }

                          Label {
                            label: bind template.item as <Clepsydre.Attendee>.uri;
                            xalign: 0;
                            wrap: true;
                          }
                        };
                      }
                    };

                    styles [
                      "attendees-list",
                    ]
                  }
                };
              }
            }
          };
        }
      }
    }

    Adw.NavigationPage {
      tag: "editor";
      title: _("Edit Event");

      Adw.ToastOverlay editor_toast_overlay {
        Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            show-start-title-buttons: false;
            show-end-title-buttons: false;
            show-back-button: false;

            [start]
            Button {
              icon-name: "cross-symbolic";
              tooltip-text: _("Cancel");
              action-name: "navigation.pop";
            }

            [end]
            $LoadingButton save {
              icon-name: "checkmark-symbolic";
              tooltip-text: _("Save");
              sensitive: false;
              clicked => $save(template);

              styles [
                "suggested-action",
              ]
            }
          }

          content: Adw.PreferencesPage {
            Adw.PreferencesGroup {
              Adw.EntryRow name_entry {
                title: _("Title");
              }

              Adw.EntryRow location_entry {
                title: _("Location");
              }

              Adw.EntryRow video_conference_entry {
                title: _("Video Conference");
              }
            }

            Adw.PreferencesGroup {
              Adw.ActionRow {
                title: _("Calendar");

                [suffix]
                Label {
                  label: "TODO";
                }
              }
            }

            Adw.PreferencesGroup {
              Adw.EntryRow description_entry {
                title: _("Description");
              }
            }
          };
        }
      }
    }
  }
}

$QrCodeDialog qr_code_dialog {
  title: _("Share Event");
  // TODO: Bind to the Event
  // Need to make qrcode url an event property
}

SortListModel attendees {
  sorter: CustomSorter attendee_sorter {};

  model: bind template.event as <Clepsydre.Event>.attendees;
}

FilterListModel participants {
  model: attendees;

  filter: CustomFilter participant_filter {};
}

FilterListModel participant_search_results {
  filter: AnyFilter {
    StringFilter {
      match-mode: substring;
      ignore-case: true;
      search: bind participant_search.text;
      expression: expr item as <Clepsydre.Attendee>.name;
    }

    StringFilter {
      match-mode: substring;
      ignore-case: true;
      search: bind participant_search.text;
      expression: expr item as <Clepsydre.Attendee>.uri;
    }
  };

  model: participants;
}

FilterListModel resources {
  model: attendees;

  filter: CustomFilter resource_filter {};
}

FilterListModel resource_search_results {
  filter: AnyFilter {
    StringFilter {
      match-mode: substring;
      ignore-case: true;
      search: bind resource_search.text;
      expression: expr item as <Clepsydre.Attendee>.name;
    }

    StringFilter {
      match-mode: substring;
      ignore-case: true;
      search: bind resource_search.text;
      expression: expr item as <Clepsydre.Attendee>.uri;
    }
  };

  model: resources;
}
