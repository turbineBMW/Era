using Gtk 4.0;
using Clepsydre 0;

template $AttendeeRow: Box {
  spacing: 6;
  margin-top: 3;
  margin-bottom: 3;

  Image {
    icon-name: "accepted-symbolic";
    visible: bind $participation_status_equals(
      template.attendee as <Clepsydre.Attendee>.participation-status,
      accepted as <Clepsydre.ParticipationStatus>
    ) as <bool>;

    styles [
      "success",
    ]
  }

  Image {
    icon-name: "questionmark-symbolic";
    visible: bind $participation_status_equals(
      template.attendee as <Clepsydre.Attendee>.participation-status,
      tentative as <Clepsydre.ParticipationStatus>
    ) as <bool>;

    styles [
      "warning",
    ]
  }

  Image {
    icon-name: "declined-symbolic";
    visible: bind $participation_status_equals(
      template.attendee as <Clepsydre.Attendee>.participation-status,
      declined as <Clepsydre.ParticipationStatus>
    ) as <bool>;

    styles [
      "error",
    ]
  }

  Image {
    icon-name: "questionmark-symbolic";
    visible: bind $none_of_three(
      $participation_status_equals(
        template.attendee as <Clepsydre.Attendee>.participation-status,
        accepted as <Clepsydre.ParticipationStatus>
      ) as <bool>,
      $participation_status_equals(
        template.attendee as <Clepsydre.Attendee>.participation-status,
        tentative as <Clepsydre.ParticipationStatus>
      ) as <bool>,
      $participation_status_equals(
        template.attendee as <Clepsydre.Attendee>.participation-status,
        declined as <Clepsydre.ParticipationStatus>
      ) as <bool>,
    ) as <bool>;
  }

  Label {
    label: bind template.attendee as <Clepsydre.Attendee>.name;
    ellipsize: end;
  }

  styles [
    "attendee-row",
  ]
}
