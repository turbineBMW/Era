using Gtk 4.0;
using Adw 1;
using Clepsydre 0;

template $CollectionRow: Box {
  orientation: vertical;
  hexpand: true;

  Box {
    spacing: 12;

    styles [
      "header",
    ]

    Label {
      label: bind template.collection as <Clepsydre.Collection>.name;
      hexpand: true;
      xalign: 0;
      wrap: true;
      wrap-mode: word_char;

      styles [
        "heading",
      ]
    }

    Button {
      icon-name: "list-add-symbolic";
      visible: bind template.collection as <Clepsydre.Collection>.calendar-creation-enabled;
      valign: center;
      clicked => $open_calendar_creation_dialog(template);

      styles [
        "flat",
      ]
    }
  }

  ListBox {
    visible: bind $is_zero(template.collection as <Clepsydre.Collection>.calendars.n-items);
    selection-mode: none;

    Adw.ActionRow {
      title: _("No Calendar in This Collection");
    }

    styles [
      "boxed-list",
    ]
  }

  ListBox calendars_list {
    visible: bind $not($is_zero(template.collection as <Clepsydre.Collection>.calendars.n-items) as <bool>);
    selection-mode: none;

    styles [
      "boxed-list",
    ]
  }
}
