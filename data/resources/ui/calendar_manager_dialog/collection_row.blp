using Gtk 4.0;
using Gio 2.0;
using Adw 1;
using Clepsydre 0;

template $CollectionRow: Box {
  orientation: vertical;
  vexpand: true;
  margin-top: 12;
  margin-bottom: 12;

  Box {
    hexpand: true;
    margin-bottom: 6;

    Label {
      label: bind template.collection as <Clepsydre.Collection>.name;
      halign: start;
      margin-bottom: 6;

      styles [
        "heading",
      ]
    }

    Button {
      icon-name: "list-add-symbolic";
      visible: bind template.collection as <Clepsydre.Collection>.calendar-creation-enabled as <bool>;
      halign: end;
      hexpand: true;
      clicked => $open_calendar_creation_dialog(template);

      styles [
        "flat",
      ]
    }
  }

  ListBox {
    visible: bind $is_zero(
      template.collection as <Clepsydre.Collection>.calendars as <Gio.ListStore>.n-items
      ) as <bool>;
    vexpand: true;
    selection-mode: none;

    Adw.ActionRow {
      title: _("No Calendar in This Collection");
    }

    styles [
      "boxed-list",
    ]
  }

  ListBox calendars_list {
    visible: bind $not(
      $is_zero(template.collection as <Clepsydre.Collection>.calendars as <Gio.ListStore>.n-items) as <bool>
    ) as <bool>;
    vexpand: true;
    selection-mode: none;

    styles [
      "boxed-list",
    ]
  }
}
