<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
    <id>@app-id@</id>
    <metadata_license>CC0-1.0</metadata_license>
    <project_license>GPL-3.0-or-later</project_license>

    <name>@app-name@</name>
    <summary>Manage your time</summary>
    <description>
        <p>
            Era is a calendar that grows with your needs - simple and calm for everyday use while
            revealing powerful tools when you need them. Use a small window side-by-side with other
            apps for multitasking or go fullscreen for complex planning. Your events can sync with
            most online providers, and Era keeps working without interruptions when you’re offline.
        </p>
    </description>

    <keywords>
        <keyword>calendar</keyword>
        <keyword>calendaring</keyword>
        <keyword>events</keyword>
        <keyword>meetings</keyword>
        <keyword>appointments</keyword>
        <keyword>scheduling</keyword>
        <keyword>planning</keyword>
        <keyword>agenda</keyword>
        <keyword>reminders</keyword>
        <keyword>alarms</keyword>
        <keyword translate="no">iCalendar</keyword>
        <keyword translate="no">ics</keyword>
        <keyword translate="no">CalDAV</keyword>
        <keyword translate="no">WebDAV</keyword>
        <keyword translate="no">Evolution</keyword>
        <keyword translate="no">Nextcloud</keyword>
        <keyword>Google Calendar</keyword>
      </keywords>

    <developer id="org.gnome.gitlab.titouanreal">
        <name translate="no">Titouan Real</name>
    </developer>

    <url type="homepage">https://gitlab.gnome.org/TitouanReal/era</url>
    <url type="vcs-browser">https://gitlab.gnome.org/TitouanReal/era</url>
    <url type="bugtracker">https://gitlab.gnome.org/TitouanReal/era/-/work_items</url>
    <url type="donation">https://ko-fi.com/titouanreal</url>
    <url type="translate">https://l10n.gnome.org/module/era/</url>
    <url type="contact">https://matrix.to/#/#era:gnome.org</url>

    <translation type="gettext">@gettext-package@</translation>
    <launchable type="desktop-id">@app-id@.desktop</launchable>
    <content_rating type="oars-1.1" />

    <branding>
        <color type="primary" scheme_preference="light">#A8D5D9</color>
        <color type="primary" scheme_preference="dark">#09636E</color>
    </branding>

    <screenshots>
        <screenshot type="default">
            <image>https://gitlab.gnome.org/TitouanReal/era/raw/main/screenshots/month.png</image>
            <caption>Month view</caption>
        </screenshot>
        <screenshot>
            <image>https://gitlab.gnome.org/TitouanReal/era/raw/main/screenshots/mobile-month.png</image>
            <caption>Mobile month view</caption>
        </screenshot>
        <screenshot>
            <image>https://gitlab.gnome.org/TitouanReal/era/raw/main/screenshots/details.png</image>
            <caption>Event details</caption>
        </screenshot>
        <screenshot>
            <image>https://gitlab.gnome.org/TitouanReal/era/raw/main/screenshots/editor.png</image>
            <caption>Event editor</caption>
        </screenshot>
    </screenshots>

    <requires>
        <display_length compare="ge">360</display_length>
    </requires>

    <supports>
        <control>keyboard</control>
        <control>pointing</control>
        <control>touch</control>
    </supports>

    <releases>
        <release version="0.2.0" date="2026-10-07">
            <description>
                <p>
                    Era 0.2.0 is now available!
                </p>
                <p>
                    The highlight of this release is the support of drag and drop in the month
                    view. Grab any event, and drop it elsewhere to move it. You can also drop the
                    event on a different application that supports receiving files, to quickly
                    export your event to an ICS file in your favorite file explorer or messaging
                    app.
                </p>
                <p>Additional changes include:</p>
                <ul>
                    <li>Import support</li>
                    <li>Performance improvements in the month view</li>
                    <li>Follow the first week day from your locale</li>
                </ul>
            </description>
        </release>
        <release version="0.1.0" date="2026-09-20">
            <description>
                <p>
                    The first beta release of Era.
                </p>
            </description>
        </release>
    </releases>

</component>
