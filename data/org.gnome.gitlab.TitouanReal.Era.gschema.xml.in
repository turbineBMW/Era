<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="@gettext-package@">
	<schema id="@app-id@" path="@resource-path@">
		<!-- fork: Omarchy theme support -->
		<key name="follow-omarchy-theme" type="b">
			<default>true</default>
			<summary>Follow the Omarchy theme</summary>
			<description>Take the window colours and light/dark style from the active Omarchy desktop theme, and follow every theme switch live. Has no effect where Omarchy isn't installed.</description>
		</key>
	</schema>
</schemalist>
